{
  "name": "lurie-guard",
  "version": "0.1.0",
  "description": "Reviews pull requests for the mistakes that cause production incidents, with measured evidence behind every rule. PostgreSQL migration pack.",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "lurie-guard": "dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "gen:rules": "node scripts/gen-rules-index.mjs",
    "test": "npm run gen:rules && vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "npm run gen:rules && tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lurielabs/lurie-guard.git"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@anthropic-ai/sdk": "0.135.0",
    "libpg-query": "18.1.5",
    "picomatch": "4.0.7",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-ruby": "0.23.1",
    "web-tree-sitter": "0.27.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/picomatch": "4.0.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "type": "module"
}
